{
  "name": "pi-provider-gemini-web",
  "version": "0.1.0",
  "description": "Use an internal gemini-web-cli server from Pi with Gemini chat continuity and native tools",
  "keywords": [
    "gemini",
    "pi-extension",
    "pi-package",
    "pi-provider"
  ],
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "lint": "oxlint .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "pre-commit": "prek run"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.79.10",
    "@earendil-works/pi-coding-agent": "^0.79.10",
    "@j178/prek": "^0.4.4",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
